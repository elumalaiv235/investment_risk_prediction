# Root Environment Configuration Example
# Backend Port
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL for production, or SQLite for zero-config local development)
DATABASE_URL="postgresql://username:password@localhost:5432/riskwise_db?schema=public"

# Authentication Secrets
JWT_SECRET="your_production_jwt_secret_key_here"
SESSION_SECRET="your_production_session_secret_key_here"

# Client URL (For backend CORS allowed origins)
CLIENT_URL="https://your-frontend-deployment.vercel.app"

# Frontend API URL (For Vite build)
VITE_API_URL="https://your-backend-api.onrender.com/api"
